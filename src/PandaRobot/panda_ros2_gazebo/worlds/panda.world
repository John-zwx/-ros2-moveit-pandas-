<sdf version="1.4">

  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>0</shadows>
    </scene>

    <!-- GAZEBO PLUGINS: -->
    <!-- The following plugins must be activated for the ros2_grasping to effectively work: -->

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/ros2_grasp</namespace>
        <argument>model_states:=model_states</argument>
        <argument>link_states:=link_states</argument>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <plugin name="gazebo_ros_properties" filename="libgazebo_ros_properties.so">
      <ros>
        <namespace>/ros2_grasp</namespace>
      </ros>
    </plugin>


    <!-- 加桌子-->
    <model name="table">
      <static>true</static>
      <pose>0 0 0.35 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.7</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.7</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>



    <!-- 加障碍-->
    <model name="box_obstacle">
      <static>true</static>
      <pose>0.3 0.3 1.05 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.7</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.7 1.0 1.0</ambient>
            <diffuse>0.6 0.8 1.0 1.0</diffuse>
            <specular>0.3 0.3 0.4 1.0</specular>
          </material>
        </visual>
      </link>
    </model>
    
    
    <!-- 加方块-->
    <!-- 
